{
  "name": "@officehum/gateway",
  "version": "0.0.0",
  "description": "The Office Hum gateway: an office's authenticated WebSocket and HTTP edge, supervising its runtime process.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "officehum-gateway": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "packages/gateway"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@officehum/protocol": "0.0.0",
    "jose": "6.2.13",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@officehum/client": "0.0.0",
    "@officehum/office": "0.0.0",
    "@types/ws": "8.18.2"
  }
}
