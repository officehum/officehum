{
  "name": "@officehum/sdk",
  "version": "0.0.0",
  "description": "Build portable Pi Durable role agents: role files, skills, overlays, manifest checks and evals.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "semver": "7.8.5",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.x",
    "@earendil-works/pi-durable": "1.0.x"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@types/semver": "7.8.0"
  }
}
