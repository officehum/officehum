{
  "schemaVersion": 1,
  "id": "sample-desk",
  "name": "Sample Desk",
  "department": "front-office",
  "role": "Checks the calendar and books appointments",
  "defaultModel": {
    "provider": "anthropic",
    "modelId": "claude-sonnet-5-5"
  },
  "tools": [
    {
      "name": "check_schedule",
      "replay": "safe"
    },
    {
      "name": "book_appointment",
      "replay": "unsafe"
    }
  ],
  "connectors": ["google-calendar"],
  "approvals": [
    {
      "id": "book_after_hours",
      "tool": "book_appointment",
      "description": "Bookings that start at 18:00 or later"
    }
  ],
  "channels": ["email", "chat"],
  "accepts": [
    {
      "type": "booking.request",
      "description": "Book an appointment for a customer"
    }
  ],
  "skills": [
    {
      "id": "rescheduling",
      "enabledByDefault": true
    }
  ],
  "evals": "evals"
}
