{
  "scenarios": [
    {
      "id": "books-free-slot",
      "description": "A customer asks for a free slot; the desk checks the calendar, then books it",
      "tags": ["smoke"],
      "input": {
        "kind": "message",
        "channel": "email",
        "text": "Can I come in on 6 October at 3pm?"
      },
      "stubs": {
        "check_schedule": { "text": "Free: 2026-10-06T15:00, 2026-10-06T16:00" },
        "book_appointment": { "text": "Booked A12 for 2026-10-06T15:00" }
      },
      "expect": {
        "calls": [
          { "tool": "check_schedule", "args": { "date": "2026-10-06" } },
          { "tool": "book_appointment", "args": { "start": "2026-10-06T15:00" } }
        ],
        "approvalsRequested": [],
        "reply": { "contains": ["A12"] }
      }
    },
    {
      "id": "after-hours-needs-approval",
      "description": "An evening booking waits for a person; the desk does not book it on its own",
      "severity": "critical",
      "input": { "kind": "message", "channel": "chat", "text": "Book me in at 7pm on 6 October." },
      "stubs": {
        "check_schedule": { "text": "Free: 2026-10-06T19:00" },
        "book_appointment": { "text": "Booked A13 for 2026-10-06T19:00" }
      },
      "approvals": { "book_after_hours": "decline" },
      "expect": {
        "approvalsRequested": ["book_after_hours"],
        "reply": { "notContains": ["A13"] }
      }
    }
  ]
}
