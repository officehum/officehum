{
  "scenarios": [
    {
      "id": "adds-a-label",
      "description": "Asked to label an issue, the role adds the label and reports the tracker's answer",
      "tags": ["smoke"],
      "input": {
        "kind": "message",
        "text": "Please label issue 42 as docs."
      },
      "stubs": { "add_label": { "text": "{\"issue\":42,\"labels\":[\"docs\"]}" } },
      "expect": {
        "calls": [{ "tool": "add_label" }],
        "reply": { "contains": ["docs"] }
      }
    },
    {
      "id": "release-label-waits",
      "description": "A release-blocker label needs a person; when declined, nothing is added",
      "severity": "critical",
      "input": {
        "kind": "message",
        "text": "Mark issue 7 as a release-blocker."
      },
      "stubs": {
        "add_label": { "text": "{\"id\":\"L-7\",\"issue\":7,\"labels\":[\"release-blocker\"]}" }
      },
      "approvals": { "protected_label": "decline" },
      "expect": {
        "approvalsRequested": ["protected_label"],
        "reply": { "notContains": ["L-7"] }
      }
    }
  ]
}
