{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officehum:schema:officehum.json:v1",
  "title": "Office Hum role manifest (officehum.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "department",
    "role",
    "defaultModel",
    "tools",
    "connectors",
    "approvals",
    "channels",
    "accepts",
    "skills",
    "evals"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64,
      "x-hint": "kebab-case, like \"front-desk\""
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "department": {
      "enum": [
        "front-office",
        "finance",
        "operations",
        "sales",
        "marketing",
        "people"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "defaultModel": {
      "type": "object",
      "required": [
        "provider",
        "modelId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "thinkingLevel": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._+-]*$",
            "maxLength": 64,
            "x-hint": "a program name, like \"python3\""
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "replay"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "maxLength": 64,
            "x-hint": "snake_case, like \"create_invoice\""
          },
          "replay": {
            "enum": [
              "safe",
              "unsafe"
            ]
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 64,
            "x-hint": "kebab-case, like \"front-desk\""
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "engine": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "parameters": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "object",
                "required": [
                  "type",
                  "description"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "number",
                      "integer",
                      "boolean"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "enum": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "guidelines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "noApproval": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "engine"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 64,
            "x-hint": "kebab-case, like \"front-desk\""
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "engine": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "maxLength": 64,
        "x-hint": "kebab-case, like \"front-desk\""
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "maxLength": 64,
            "x-hint": "snake_case, like \"create_invoice\""
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
            "maxLength": 64,
            "x-hint": "snake_case, like \"create_invoice\""
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "when": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "arg",
                "op"
              ],
              "properties": {
                "arg": {
                  "type": "string",
                  "minLength": 1
                },
                "op": {
                  "enum": [
                    "gt",
                    "gte",
                    "lt",
                    "lte",
                    "eq",
                    "ne",
                    "in",
                    "present",
                    "absent"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "limit"
                      ],
                      "properties": {
                        "limit": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                          "maxLength": 64,
                          "x-hint": "snake_case, like \"create_invoice\""
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "description",
            "default"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "default": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "email",
              "sms",
              "chat"
            ]
          },
          {
            "type": "object",
            "required": [
              "channel",
              "direction"
            ],
            "properties": {
              "channel": {
                "enum": [
                  "email",
                  "sms",
                  "chat"
                ]
              },
              "direction": {
                "enum": [
                  "inbound",
                  "outbound",
                  "both"
                ]
              },
              "replyBy": {
                "enum": [
                  "email",
                  "sms",
                  "chat"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 160
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "accepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "maxLength": 64,
            "x-hint": "a dotted ticket type, like \"invoice.create\""
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "done": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "engine"
                  ],
                  "properties": {
                    "engine": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "args": {
                      "type": "object",
                      "patternProperties": {
                        "^.*$": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "tool",
                    "expect"
                  ],
                  "properties": {
                    "tool": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                      "maxLength": 64,
                      "x-hint": "snake_case, like \"create_invoice\""
                    },
                    "args": {
                      "type": "object",
                      "patternProperties": {
                        "^.*$": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      }
                    },
                    "expect": {
                      "type": "string",
                      "const": "found"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "file"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "person"
                  ],
                  "properties": {
                    "person": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "x-hint": "must be one of: { \"engine\": [\"subcommand\", …], \"args\": { \"flag\": \"{ticket.data.<path>}\" } }, { \"tool\": \"NAME\", \"args\": {…}, \"expect\": \"found\" }, { \"file\": \"NAME\" }, or { \"person\": true }"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "dispatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "when"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "maxLength": 64,
            "x-hint": "a dotted ticket type, like \"invoice.create\""
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    "mayNot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "instead"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "instead": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    },
    "contextPlan": {
      "type": "object",
      "properties": {
        "promptBudgetTokens": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval": {
          "type": "object",
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "description"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                    "maxLength": 64,
                    "x-hint": "kebab-case, like \"front-desk\""
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "purpose",
              "model",
              "tools",
              "output"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 64,
                "x-hint": "kebab-case, like \"front-desk\""
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "model": {
                "enum": [
                  "small",
                  "default"
                ]
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                  "maxLength": 64,
                  "x-hint": "snake_case, like \"create_invoice\""
                },
                "minItems": 1
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                  "maxLength": 64,
                  "x-hint": "kebab-case, like \"front-desk\""
                },
                "minItems": 1
              },
              "output": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "maxParallel": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "historyFilter": {
          "type": "object",
          "required": [
            "keepRecentRounds",
            "keepCitedIds",
            "maxToolResultTokens"
          ],
          "properties": {
            "keepRecentRounds": {
              "type": "integer",
              "minimum": 0
            },
            "keepCitedIds": {
              "type": "boolean"
            },
            "maxToolResultTokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "maskAmounts": {
          "type": "boolean"
        },
        "modelTiers": {
          "type": "object",
          "required": [
            "small"
          ],
          "properties": {
            "small": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "memorySubjects": {
          "type": "array",
          "items": {
            "enum": [
              "business",
              "customer",
              "vendor",
              "person",
              "agent",
              "topic"
            ]
          },
          "minItems": 1
        },
        "toolGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "tools",
              "forTicketTypes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 64,
                "x-hint": "kebab-case, like \"front-desk\""
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
                  "maxLength": 64,
                  "x-hint": "snake_case, like \"create_invoice\""
                },
                "minItems": 1
              },
              "forTicketTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
                  "maxLength": 64,
                  "x-hint": "a dotted ticket type, like \"invoice.create\""
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "enabledByDefault"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 64,
            "x-hint": "kebab-case, like \"front-desk\""
          },
          "enabledByDefault": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "evals": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
