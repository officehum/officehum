{
  "title": "Report",
  "description": "A report: title, optional subtitle, author, date and summary, then sections of paragraphs with an optional table each. Table cells are text; figures in them come from the data as given.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 300 },
    "author": { "type": "string", "minLength": 1, "maxLength": 200 },
    "date": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string", "minLength": 1, "maxLength": 300 },
          "paragraphs": {
            "type": "array",
            "maxItems": 40,
            "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns", "rows"],
            "properties": {
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 60,
                "items": {
                  "type": "array",
                  "maxItems": 12,
                  "items": { "type": "string", "maxLength": 1000 }
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "title": "November operations report",
      "subtitle": "Warehouse and deliveries",
      "author": "Operations",
      "date": "1 December 2026",
      "summary": "Deliveries ran on time and the new shelving is in place.",
      "sections": [
        {
          "heading": "Deliveries",
          "paragraphs": ["Every delivery left on its planned day."],
          "table": {
            "columns": ["Week", "Deliveries", "On time"],
            "rows": [["Week 1", "41", "41"], ["Week 2", "38", "37"]]
          }
        },
        { "heading": "Warehouse", "paragraphs": ["The new shelving in bay 3 is finished."] }
      ]
    }
  ]
}
