{
  "title": "Quote",
  "description": "A priced quote: number, dates, customer, line items with amounts, subtotal, optional tax and total. Every figure is supplied; the subtotal must equal the sum of the line amounts, and the total the subtotal plus tax.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "date",
    "validUntil",
    "customer",
    "currency",
    "lines",
    "subtotal",
    "total"
  ],
  "properties": {
    "number": { "type": "string", "minLength": 1, "maxLength": 64 },
    "date": { "type": "string", "minLength": 1, "maxLength": 64 },
    "validUntil": { "type": "string", "minLength": 1, "maxLength": 64 },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "address": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "currency": { "type": "string", "minLength": 1, "maxLength": 8 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unitPrice", "amount"],
        "properties": {
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "quantity": { "type": "number" },
          "unitPrice": { "type": "number" },
          "amount": { "type": "number" }
        }
      }
    },
    "subtotal": { "type": "number" },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "amount"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number" }
      }
    },
    "total": { "type": "number" },
    "terms": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "examples": [
    {
      "number": "Q-2026-0142",
      "date": "24 November 2026",
      "validUntil": "24 December 2026",
      "customer": { "name": "Lee Hardware", "address": ["12 Mill Road", "Springfield"] },
      "currency": "USD",
      "lines": [
        {
          "description": "Steel shelving unit, 2 m",
          "quantity": 4,
          "unitPrice": 189.5,
          "amount": 758
        },
        { "description": "Installation", "quantity": 1, "unitPrice": 240, "amount": 240 }
      ],
      "subtotal": 998,
      "tax": { "label": "Sales tax 8%", "amount": 79.84 },
      "total": 1077.84,
      "terms": ["Payment due within 30 days of delivery."]
    }
  ]
}
