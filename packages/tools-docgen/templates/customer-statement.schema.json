{
  "title": "Customer statement",
  "description": "A customer's account statement for a period: opening balance, each charge and payment with the running balance, totals, closing balance and amount due. Every figure is supplied; the totals must equal the sums of the lines' charges and payments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer",
    "statementDate",
    "periodStart",
    "periodEnd",
    "currency",
    "openingBalance",
    "lines",
    "totals",
    "closingBalance",
    "amountDue"
  ],
  "properties": {
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "account": { "type": "string", "minLength": 1, "maxLength": 64 },
        "address": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "statementDate": { "type": "string", "minLength": 1, "maxLength": 64 },
    "periodStart": { "type": "string", "minLength": 1, "maxLength": 64 },
    "periodEnd": { "type": "string", "minLength": 1, "maxLength": 64 },
    "currency": { "type": "string", "minLength": 1, "maxLength": 8 },
    "openingBalance": { "type": "number" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "reference", "description", "charges", "payments", "balance"],
        "properties": {
          "date": { "type": "string", "minLength": 1, "maxLength": 64 },
          "reference": { "type": "string", "maxLength": 64 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "charges": { "type": "number" },
          "payments": { "type": "number" },
          "balance": { "type": "number" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charges", "payments"],
      "properties": {
        "charges": { "type": "number" },
        "payments": { "type": "number" }
      }
    },
    "closingBalance": { "type": "number" },
    "amountDue": { "type": "number" },
    "dueDate": { "type": "string", "minLength": 1, "maxLength": 64 },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "examples": [
    {
      "customer": {
        "name": "Lee Hardware",
        "account": "C-1042",
        "address": ["12 Mill Road", "Springfield"]
      },
      "statementDate": "30 November 2026",
      "periodStart": "1 November 2026",
      "periodEnd": "30 November 2026",
      "currency": "USD",
      "openingBalance": 1250,
      "lines": [
        {
          "date": "4 Nov 2026",
          "reference": "INV-2207",
          "description": "Steel shelving, 4 units",
          "charges": 1077.84,
          "payments": 0,
          "balance": 2327.84
        },
        {
          "date": "12 Nov 2026",
          "reference": "PAY-881",
          "description": "Payment, thank you",
          "charges": 0,
          "payments": 1250,
          "balance": 1077.84
        },
        {
          "date": "21 Nov 2026",
          "reference": "INV-2231",
          "description": "Bolts and brackets",
          "charges": 64.2,
          "payments": 0,
          "balance": 1142.04
        }
      ],
      "totals": { "charges": 1142.04, "payments": 1250 },
      "closingBalance": 1142.04,
      "amountDue": 1142.04,
      "dueDate": "30 December 2026"
    }
  ]
}
