{
  "name": "@officehum/tools-docgen",
  "version": "0.0.0",
  "description": "Portable document generation pack: branded PDF (Typst), Word and Excel from templates, with every number supplied as data.",
  "keywords": [
    "officehum",
    "pi-durable",
    "pi-ai",
    "pi-agent",
    "ai-agents"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "packages/tools-docgen"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@officehum/sdk": "0.0.0",
    "@officehum/tools-paper-office": "0.0.0",
    "typebox": "1.4.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.6.x",
    "@earendil-works/pi-durable": "1.6.x",
    "@earendil-works/pi-schema": "1.6.x"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@officehum/tools-documents": "0.0.0"
  }
}
