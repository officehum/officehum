{
  "name": "@officehum/runner",
  "version": "0.0.0",
  "description": "Runs one Office Hum role package on a Pi Durable harness: the harness adapter, role loading, one-role runs, the bare eval runner, the scripted model and the eval judge.",
  "keywords": [
    "officehum",
    "pi-durable",
    "pi-ai",
    "pi-agent",
    "ai-agents"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/scripted-model.d.ts",
      "import": "./dist/testing/scripted-model.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "packages/runner"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@officehum/memory": "0.0.0",
    "@officehum/sdk": "0.0.0"
  }
}
