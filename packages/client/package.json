{
  "name": "@officehum/client",
  "version": "0.0.0",
  "description": "A TypeScript client for the Office Hum Gateway Protocol, for Node 22 and modern browsers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "packages/client"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@officehum/protocol": "0.0.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "ws": "8.22.2"
  }
}
