{
  "name": "@officehum/office",
  "version": "0.0.0",
  "description": "The Office: workboard, relay and workflow engine that let Office Hum agents work together on one machine.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/scripted-model.d.ts",
      "import": "./dist/testing/scripted-model.js"
    },
    "./board": {
      "types": "./dist/board/host.d.ts",
      "import": "./dist/board/host.js"
    },
    "./board/testing": {
      "types": "./dist/board/testing.d.ts",
      "import": "./dist/board/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "packages/office"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@officehum/channels": "0.0.0",
    "@officehum/google-calendar": "0.0.0",
    "@officehum/sdk": "0.0.0",
    "html-to-text": "10.0.1"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4"
  }
}
