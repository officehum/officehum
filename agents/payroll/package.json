{
  "name": "@officehum/payroll",
  "version": "0.0.0",
  "description": "Portable Payroll and Benefits role: checks timesheets, prepares pay runs with overtime worked out per workweek, sends every pay run to a person to approve, records benefit changes inside open enrolment or after a qualifying life event, asks a person for exceptions and corrections, and gives each employee only their own pay and benefits.",
  "keywords": [
    "officehum",
    "pi-durable",
    "pi-ai",
    "pi-agent",
    "ai-agents",
    "officehum-role"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "agents/payroll"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "officehum.json",
    "AGENTS.md",
    "APPEND_SYSTEM.md",
    "role.md",
    "role.sources.json",
    "skills",
    "evals"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.6.x",
    "@earendil-works/pi-durable": "1.6.x",
    "@earendil-works/pi-schema": "1.6.x"
  },
  "dependencies": {
    "@officehum/sdk": "0.0.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@officehum/runner": "0.0.0"
  }
}
