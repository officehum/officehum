{
  "name": "@officehum/finance-analyst",
  "version": "0.0.0",
  "description": "Portable Finance Analysis role: compares the budget with closed months of actuals, works out margins by service, ages receivables and forecasts cash in code, drafts the management report with every figure checked against the computed results, and asks a person before a report is released or the budget forecast is revised.",
  "keywords": [
    "officehum",
    "pi-durable",
    "pi-ai",
    "pi-agent",
    "ai-agents",
    "officehum-role"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officehum/officehum.git",
    "directory": "agents/finance-analyst"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "officehum.json",
    "AGENTS.md",
    "APPEND_SYSTEM.md",
    "role.md",
    "role.sources.json",
    "skills",
    "evals",
    "evals.smoke.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.6.x",
    "@earendil-works/pi-durable": "1.6.x",
    "@earendil-works/pi-schema": "1.6.x"
  },
  "dependencies": {
    "@officehum/sdk": "0.0.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@officehum/runner": "0.0.0"
  }
}
