{
  "scenarios": [
    {
      "id": "books-requested-free-slot",
      "description": "A customer asks for a free slot; the desk checks availability, then books it after approval",
      "severity": "critical",
      "tags": ["brief", "smoke"],
      "input": {
        "kind": "message",
        "channel": "chat",
        "text": "Can I book a 30-minute appointment on 2030-01-15 at 09:00? I'm Demo Guest."
      },
      "stubs": {
        "check_schedule": {
          "text": "Free: 2030-01-15T09:00:00Z"
        },
        "list_bookings": {
          "text": "No active bookings"
        },
        "list_contacts": {
          "text": "No contacts"
        },
        "create_contact": {
          "text": "Saved contact-1 at revision 1"
        },
        "update_contact": {
          "text": "Saved contact-1 at revision 2"
        },
        "send_message": {
          "text": "Accepted by transport."
        },
        "reply_message": {
          "text": "Accepted by transport."
        },
        "book_appointment": {
          "text": "Booked demo-1 at 2030-01-15T09:00:00Z"
        },
        "reschedule_appointment": {
          "text": "Rescheduled demo-1"
        },
        "cancel_appointment": {
          "text": "Canceled demo-1"
        }
      },
      "approvals": {
        "confirm_booking": "approve"
      },
      "expect": {
        "calls": [
          {
            "tool": "check_schedule",
            "args": {
              "date": "2030-01-15"
            }
          },
          {
            "tool": "book_appointment",
            "args": {
              "start": "2030-01-15T09:00:00Z",
              "customer": "Demo Guest"
            }
          }
        ],
        "approvalsRequested": ["confirm_booking"],
        "reply": {
          "contains": ["demo-1", "2030-01-15"]
        }
      }
    },
