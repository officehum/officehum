{
  "schemaVersion": 1,
  "id": "frontdesk",
  "name": "Front Desk",
  "department": "front-office",
  "role": "Manages approved contacts, messages, and UTC appointments",
  "defaultModel": { "provider": "paper", "modelId": "ultramarine-1-flash", "thinkingLevel": "max" },
  "tools": [
    { "name": "check_schedule", "replay": "safe" },
    { "name": "list_bookings", "replay": "safe" },
    { "name": "list_contacts", "replay": "safe" },
    { "name": "create_contact", "replay": "safe" },
    { "name": "update_contact", "replay": "safe" },
    { "name": "send_message", "replay": "safe" },
    { "name": "reply_message", "replay": "safe" },
    { "name": "book_appointment", "replay": "safe" },
    { "name": "reschedule_appointment", "replay": "safe" },
    { "name": "cancel_appointment", "replay": "safe" }
  ],
  "connectors": [],
  "approvals": [
    {
      "id": "confirm_contact_creation",
      "tool": "create_contact",
      "description": "Confirm this contact creation"
    },
    {
      "id": "confirm_contact_update",
      "tool": "update_contact",
      "description": "Confirm this contact correction"
    },
    {
      "id": "first_contact",
      "tool": "send_message",
      "description": "Confirm first contact with this destination and transport"
    },
    {
      "id": "confirm_booking",
      "tool": "book_appointment",
      "description": "Confirm this appointment booking"
    },
    {
      "id": "confirm_reschedule",
      "tool": "reschedule_appointment",
      "description": "Confirm this appointment reschedule"
    },
    {
      "id": "confirm_cancellation",
      "tool": "cancel_appointment",
      "description": "Confirm this appointment cancellation"
    }
  ],
  "channels": ["chat"],
  "accepts": [
    {
      "type": "booking.request",
      "description": "Book an appointment for a customer",
      "done": [
        {
          "tool": "list_bookings",
          "args": { "bookingId": "{ticket.data.bookingId}" },
          "expect": "found"
        },
        { "person": true }
      ]
    }
  ],
  "skills": [],
  "evals": "evals"
}
